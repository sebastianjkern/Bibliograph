# Non-secret, semi-static configuration. Select with --profile NAME.

[profiles.default]
db = "bibliograph.db"
pdf_dir = "pdfs"
collection = "My Collection"

# Optional local page OCR. Set provider = "ollama" to OCR scanned or poor-text
# pages with Granite Docling; in hybrid mode clean embedded PDF text stays native.
[profiles.default.pdf_extraction]
provider = "pymupdf" # set to "ollama" to enable local vision OCR
ollama_model = "ibm/granite-docling:258m"
ollama_base_url = "http://localhost:11434"
ollama_mode = "hybrid" # "all" sends every page through the model
min_text_chars = 120

[profiles.default.embedding]
provider = "ollama"
model = "nomic-embed-text"
base_url = "http://localhost:11434"
batch_size = 32

[profiles.default.llm]
provider = "ollama"
model = "rnj-1"
base_url = "http://localhost:11434"
mode = "optional"
stages = ["expand", "rerank", "evidence", "rationale"]

# Optional per-stage provider/model overrides. Unlisted settings inherit from [llm].
[profiles.default.llm.models]
expand = "qwen3:8b" # shorthand: same provider and connection settings as [llm]
rerank = "rnj-1"
evidence = "gemma3:4b"

# Codex uses the locally installed CLI and its existing ChatGPT authentication.
[profiles.default.llm.models.rationale]
provider = "codex"
model = "gpt-6-luna"

# Optional chunk-level evidence-role labels. Enabling this requires a rebuild.
[profiles.default.classification]
enabled = false
# model = "qwen3:8b" # defaults to llm.model

[profiles.default.acquisition]
order = ["cache", "zotero-storage", "zotero-api", "remote"]

[profiles.default.remote]
# Set a persistent profile only when legitimate browser-authenticated access is needed.
playwright_profile = ""
playwright_headless = true
