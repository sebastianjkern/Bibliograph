#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

for env_file in dev.env .env; do
    [[ -f "$env_file" ]] || continue
    set -a
    # These are developer-owned local files and are intentionally shell-sourced.
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
done

mapfile -d '' staged_files < <(git diff --cached --name-only --diff-filter=ACMR -z)
python_files=()
for file in "${staged_files[@]}"; do
    [[ "$file" == *.py ]] && python_files+=("$file")
done

if ((${#python_files[@]})); then
    echo "Running Ruff on staged Python files..."
    uv run --extra dev ruff check "${python_files[@]}"
    uv run --extra dev ruff format --check "${python_files[@]}"
fi

echo "Running mypy..."
uv run --extra dev mypy

if [[ -z "${SONAR_TOKEN:-}" || "$SONAR_TOKEN" == "your_sonarqube_project_token" ]]; then
    echo "SonarQube pre-commit check needs SONAR_TOKEN. Copy dev.env.example to dev.env and set it there." >&2
    exit 1
fi
sonar_scanner="$(command -v sonar-scanner || true)"
if [[ -z "$sonar_scanner" && -x "$HOME/.local/bin/sonar-scanner" ]]; then
    sonar_scanner="$HOME/.local/bin/sonar-scanner"
fi
if [[ -z "$sonar_scanner" ]]; then
    echo "SonarScanner CLI was not found on PATH; install it before committing." >&2
    exit 1
fi

sonar_host_url="${SONAR_HOST_URL:-http://localhost:9000}"
echo "Running SonarQube analysis against ${sonar_host_url}..."
"$sonar_scanner" -Dsonar.host.url="$sonar_host_url"
