#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

for env_file in dev.env .env; do
    [[ -f "$env_file" ]] || continue
    set -a
    # These are developer-owned local files and are intentionally shell-sourced.
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
done

mapfile -d '' staged_files < <(git diff --cached --name-only --diff-filter=ACMR -z)
python_files=()
for file in "${staged_files[@]}"; do
    [[ "$file" == *.py ]] && python_files+=("$file")
done

if ((${#python_files[@]})); then
    echo "Running Ruff on staged Python files..."
    uv run --extra dev ruff check "${python_files[@]}"
    uv run --extra dev ruff format --check "${python_files[@]}"
fi

echo "Running mypy..."
uv run --extra dev mypy

echo "Running tests and generating coverage.xml..."
uv run --extra dev pytest --cov=bibliograph --cov-report=term-missing --cov-report=xml:coverage.xml
