# Generic settings take precedence over the legacy names below. Keep models,
# providers, paths, and acquisition order in bibliograph.toml where possible.
BIBLIOGRAPH_DB=
BIBLIOGRAPH_PDF_DIR=
BIBLIOGRAPH_COLLECTION=

# Zotero credentials and an optional local storage directory.
BIBLIOGRAPH_ZOTERO_LIBRARY_ID=
BIBLIOGRAPH_ZOTERO_LIBRARY_TYPE=user
BIBLIOGRAPH_ZOTERO_API_KEY=
BIBLIOGRAPH_ZOTERO_STORAGE_DIR=

# Provider secrets. Set only the variables used by the selected profile.
BIBLIOGRAPH_EMBEDDING_API_KEY=
BIBLIOGRAPH_LLM_API_KEY=

# Legal remote-acquisition services.
BIBLIOGRAPH_REMOTE_UNPAYWALL_EMAIL=
BIBLIOGRAPH_REMOTE_OPENALEX_API_KEY=
# Optional persistent browser profile and browser mode for the remote fallback.
BIBLIOGRAPH_REMOTE_PLAYWRIGHT_PROFILE=
BIBLIOGRAPH_REMOTE_PLAYWRIGHT_HEADLESS=true

# Compatibility variables accepted during the transition.
# ZOTERO_LIBRARY_ID=
# ZOTERO_LIBRARY_TYPE=user
# ZOTERO_API_KEY=
# ZOTERO_STORAGE_DIR=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_LLM_MODEL=rnj-1
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# SENTENCE_TRANSFORMERS_CACHE=
# SENTENCE_TRANSFORMERS_OFFLINE=false
# UNPAYWALL_EMAIL=
# OPENALEX_API_KEY=
